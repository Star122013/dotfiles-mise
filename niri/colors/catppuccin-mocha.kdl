// Catppuccin Mocha Theme for Niri

layout {
    focus-ring {
        // Active: Mauve
        active-color   "#cba6f7"
        // Inactive: Base background
        inactive-color "#1e1e2e"
        // Urgent: Red
        urgent-color   "#f38ba8"
    }

    border {
        active-color   "#cba6f7"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    shadow {
        // 深色主题下使用半透明黑色阴影
        color "#00000070"
    }

    tab-indicator {
        active-color   "#cba6f7"
        // Inactive Tab: 使用较柔和的表面层颜色
        inactive-color "#585b70"
        urgent-color   "#f38ba8"
    }

    insert-hint {
        // Active color with 50% opacity
        color "#cba6f780"
    }
}
