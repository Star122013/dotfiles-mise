{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "pathStrict": false,
    "path": [
      "?.lua",
      "?/init.lua",
      "lua/?.lua",
      "lua/?/init.lua"
    ]
  },
  "workspace": {
    "checkThirdParty": "apply",
    "library": [
      "/usr/share/nvim/runtime",
      "/usr/share/nvim/runtime/lua",
      "${3rd}/luv/library",
      "/var/home/qwerhyy/.local/share/nvim/site/pack/core"
    ],
    "ignoreDir": []
  },
  "diagnostics": {
    "globals": [
      "vim",
      "MiniPick",
      "MiniExtra",
      "MiniBase16",
      "MiniColors",
      "MiniHipatterns",
      "MiniTrailspace",
      "MiniAnimate",
      "MiniBracketed",
      "MiniComment",
      "MiniCursorword",
      "MiniIcons",
      "MiniIndentscope",
      "MiniMove",
      "MiniOperators",
      "MiniPairs",
      "MiniSplitjoin",
      "MiniSurround",
      "MiniInput",
      "MiniNotify",
      "MiniStatusline",
      "MiniTabline",
      "MiniFiles",
      "MiniClue",
      "MiniPick",
      "MiniTest"
    ]
  },
  "hint": {
    "enable": true,
    "paramType": true,
    "paramName": "all",
    "arrayIndex": "auto"
  },
  "completion": {
    "autoRequire": true,
    "callSnippet": "Disable"
  }
}
