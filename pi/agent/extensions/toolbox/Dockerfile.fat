# pi-toolbox - 全能工具箱镜像 (podman build -t pi-toolbox -f Dockerfile .)
# typst + 常用工具 + 常见语言
FROM alpine:latest

RUN apk add --no-cache \
    # 核心工具
    typst \
    bash git ripgrep curl wget ca-certificates \
    graphviz pandoc-cli \
    imagemagick ghostscript librsvg \
    font-noto font-noto-cjk font-noto-emoji \
    # 常见语言 / 包管理器
    python3 py3-pip python3-dev py3-virtualenv \
    nodejs npm \
    go \
    rust cargo \
    ruby ruby-dev \
    zig \
    # 编译依赖 (部分包需要)
    build-base pkgconfig \
  && rm -rf /var/cache/apk/*

# mermaid-cli 走 npm (apk 无此包)
RUN npm install -g @mermaid-js/mermaid-cli 2>/dev/null || true

# python 常用包 + uv 加速
RUN pip install --no-cache-dir --break-system-packages uv ruff 2>/dev/null || true

WORKDIR /workspace
CMD ["sh"]
