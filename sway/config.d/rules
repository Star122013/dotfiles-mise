# Sway window rules
# Ported from niri's rules.kdl and hyprland's window-rules.lua

# Floating windows (from niri rules.kdl)
for_window [title="^(file_progress)$"] floating enable
for_window [title="^(confirm)$"] floating enable
for_window [title="^(dialog)$"] floating enable
for_window [title="^(download)$"] floating enable
for_window [title="^(error)$"] floating enable
for_window [title="^(splash)$"] floating enable
for_window [title="^(nwg-look)$"] floating enable
for_window [title="^(confirmreset)$"] floating enable
for_window [title="^(Delete profile)$"] floating enable
for_window [title="^File Operation Progress$"] floating enable
for_window [title="^Confirm to replace files$"] floating enable
for_window [title="^KDE Connect URL handler$"] floating enable
for_window [title="^Picture-in-Picture$"] floating enable
for_window [title="^satty$"] floating enable
for_window [app_id="^com.gabm.satty$"] floating enable
for_window [app_id="^org.pulseaudio.pavucontrol$"] floating enable
for_window [app_id="^net.davidotek.pupgui2$"] floating enable
for_window [app_id="^org.qbittorrent.qBittorrent$"] floating enable

# Floating QQ image viewer
for_window [app_id="^QQ$" title="^图片查看器$"] floating enable, resize set 50 ppt 50 ppt
for_window [app_id="^QQ$" title="^群聊的聊天记录$"] floating enable, resize set 50 ppt 50 ppt
for_window [app_id="^QQ$"] floating enable, resize set 70 ppt 70 ppt
# Steam notification toasts
for_window [app_id="steam" title="^notificationtoasts"] floating enable, move position 10 10

# Maximized windows (from niri rules.kdl)
for_window [app_id="^org.telegram.desktop$"] fullscreen enable
for_window [app_id="^zen$"] fullscreen enable
for_window [app_id="^thunar$"] fullscreen enable
for_window [app_id="^dolphin$"] fullscreen enable
for_window [app_id="^obsidian$"] fullscreen enable
for_window [app_id="^Spotify$"] fullscreen enable
for_window [app_id="^Element$"] fullscreen enable
for_window [app_id="^mpv$"] fullscreen enable

