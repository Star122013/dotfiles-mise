# Sway monitor configuration
# Ported from niri's monitor.kdl and hyprland's monitors.lua
# Sway 1.12+: HDR10 + color-management-v1 (requires WLR_RENDERER=vulkan)
# Check `swaymsg -t get_outputs` to see available outputs

# Main display with HDR support
output DP-2 {
    mode 2560x1440@170Hz
    scale 1
    # Enable HDR10 (BT.2020 primaries + PQ transfer function)
    # Implicitly sets render_bit_depth 10
    # Requires WLR_RENDERER=vulkan environment variable
    hdr off
    # Note: color_profile is not compatible with hdr on
    # The ICC profile is still useful for SDR-only setups
    color_profile icc ~/.config/sway/color_01.icc
}

# QEMU display (SDR, use ICC for accurate color)
output "Red Hat, Inc. QEMU Monitor Unknown" {
    mode 3840x2160@60Hz
    scale 1.5
    hdr off
    color_profile icc ~/.local/share/icc/edid-40a4810cffbdfa3a94887ccad1b6a82a.icc
}
