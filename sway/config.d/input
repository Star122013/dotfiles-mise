# Sway input configuration
# Ported from niri's input.kdl and hyprland's input.lua

# Keyboard
input "*" {
    xkb_layout "us"
}

# Touchpad (natural scrolling only for touchpad, not mouse)
input type:touchpad {
    natural_scroll enabled
    tap enabled
    dwt enabled
    pointer_accel 0.5
}

# Mouse (no natural scroll, so wheel works normally)
input type:pointer {
    accel_profile "adaptive"
    pointer_accel 0.5
}

# Focus follows mouse
set $focus_follows_mouse yes
set $mouse_warping output
