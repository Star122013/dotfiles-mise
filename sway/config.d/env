# Sway environment variables
# Reference: mirrors niri's env.kdl + sway 1.12 HDR10/color-management additions
#
# NOTE: sway 的 config 不能直接 set 环境变量（set $VAR val 只是 sway 内部变量）
# 这里用 exec_always systemctl --user set-environment 来设置，
# 这样 systemd user 服务和后续启动的进程都能继承到。
# 但 WLR_RENDERER 必须在 sway 启动前就设好（见下方说明）。

# === Renderer (required for HDR10 + color-management-v1) ===
# WLR_RENDERER 必须在 sway 启动前设置，exec_always 对它无效。
# 请在 ~/.profile / ~/.zprofile / environment.d 中设置：
#   export WLR_RENDERER=vulkan
# 或者用 sway 包装脚本启动。

# === Sway 1.12: suppress unsupported GPU warning (NVIDIA etc.) ===
# 同样需要在 sway 启动前设置：
#   export SWAY_UNSUPPORTED_GPU=1

# === Wayland ===
exec_always systemctl --user set-environment XDG_SESSION_TYPE=wayland
exec_always systemctl --user set-environment XDG_CURRENT_DESKTOP=Sway
exec_always systemctl --user set-environment XDG_SESSION_DESKTOP=Sway

# === Qt ===
exec_always systemctl --user set-environment QT_QPA_PLATFORM=wayland
exec_always systemctl --user set-environment QT_QPA_PLATFORMTHEME=gtk3
exec_always systemctl --user set-environment QT_IM_MODULES=wayland;fcitx

# === GTK ===
exec_always systemctl --user set-environment GDK_BACKEND=wayland,x11,*

# === SDL ===
exec_always systemctl --user set-environment SDL_VIDEODRIVER=wayland,x11
exec_always systemctl --user set-environment SDL_IM_MODULE=fcitx

# === Mozilla ===
exec_always systemctl --user set-environment MOZ_ENABLE_WAYLAND=1

# === Fcitx5 ===
exec_always systemctl --user set-environment XMODIFIERS=@im=fcitx
exec_always systemctl --user set-environment INPUT_METHOD=fcitx

# === Other ===
exec_always systemctl --user set-environment EDITOR=hx
exec_always systemctl --user set-environment CLUTTER_BACKEND=wayland
exec_always systemctl --user set-environment DISPLAY=:0
exec_always systemctl --user set-environment XCURSOR_SIZE=24
