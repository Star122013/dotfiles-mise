# Ghostty configuration
# Managed via dotfiles (symlinked by home-manager)

command = bash
shell-integration-features = no-cursor, ssh-terminfo

theme = TokyoNight

# Font (monospace + CJK fallback), sized up for readability
# NOTE: ghostty's font-family does NOT split on comma — one family per key.
# CJK must go in font-family-fallback, not appended after the comma.
font-family = Iosevka Star Term
font-size = 16

# Appearance
cursor-style = block
cursor-style-blink = true
background-blur = true
window-decoration = client
window-show-tab-bar = auto
gtk-tabs-location = bottom
gtk-wide-tabs = false
gtk-titlebar = false
gtk-titlebar-style = native

# Behavior
cursor-click-to-move = false
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m
confirm-close-surface = false
copy-on-select = clipboard

# Keybindings
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+-=new_split:down

# Quick terminal (scratchpad) — centered, 70% size, overlay layer
quick-terminal-position = center
quick-terminal-size = 50%,70%
quick-terminal-screen = mouse
gtk-quick-terminal-layer = top
